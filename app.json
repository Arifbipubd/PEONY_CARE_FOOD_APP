{
  "expo": {
    "name": "UduFood",
    "slug": "udufood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8102E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.udufood.app"
    },
    "android": {
      "package": "com.udufood.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "UDUFood needs camera access to scan claim QR codes and take profile photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UDUFood needs your location to show complementary meals near you and confirm you are close enough to claim.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.google.android.gms.maps.** { *; }\n-keep class com.google.maps.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08f578e1-89f7-4296-ab36-fefe9b6116b7"
      }
    },
    "owner": "arifbipu"
  }
}
